{
  "name": "torneos-web",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "bash scripts/dev.sh",
    "dev:clean": "rm -rf .next && prisma generate && next dev --turbopack -p 8080",
    "build": "prisma generate && next build --turbopack",
    "start": "next start -p 8080",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/group-standing.test.ts",
    "validate": "npm run lint && npm run typecheck && npm run build",
    "db:local": "bash scripts/local-mysql.sh",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "bootstrap:admin": "bash scripts/bootstrap-admin.sh",
    "db:seed": "tsx prisma/seed.ts",
    "docker:build": "docker build -t carloscacua/tribanda:latest .",
    "docker:push": "docker push carloscacua/tribanda:latest"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.46.0",
    "next": "15.5.9",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "^7.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^7.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "prisma": "^6.16.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
