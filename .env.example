# MySQL local (docker compose)
# DATABASE_URL="mysql://tribanda:changeme-tribanda@127.0.0.1:3306/tribanda"
# MySQL producción: codifica * ! @ # % en la contraseña (ej. * → %2A, ! → %21)
# DATABASE_URL="mysql://USER:PASS_ENCODED@HOST:3306/tribanda"
DATABASE_URL="mysql://tribanda:changeme-tribanda@127.0.0.1:3306/tribanda"
AUTH_SECRET="genera-un-secreto-largo"
AUTH_TRUST_HOST="true"
PORT=8080

# URL pública (enlaces de “olvidé mi contraseña”). En local puede omitirse.
# APP_URL=https://tribanda.grupounico.com.co

# SMTP para recuperación de contraseña (organizador / admin)
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=TriBanda <noreply@tudominio.com>

# Primer administrador (solo si no hay ningún ADMIN): bash scripts/bootstrap-admin.sh
# BOOTSTRAP_ADMIN_EMAIL=admin@ejemplo.com
# BOOTSTRAP_ADMIN_PASSWORD=minimo-6-chars
# BOOTSTRAP_ADMIN_NAME=Administrador
